{% block flash_revpi %}
{% if CAN_FLASH %}
{# Download the image that will be programmed onto the DUT #}
{% set deploy_to = "downloads" %}
{% set namespace = "recovery" %}
{% set recovery_image_url = REVPI_FLASH_IMAGE %}
{% set timeout_minutes = 10 %}
{% include "include/actions/deploy.jinja2" %}

{# Boot recovery: power cycle the DUT and expose its storage as /dev/blockDUT #}
{% set boot_method = "recovery" %}
{% set boot_commands = "recovery" %}
{% set namespace = "recovery" %}
{% set timeout_minutes = 5 %}
{% include "include/actions/boot.jinja2" %}

{# Test: program the image from a docker container on the worker #}
{% set namespace = "recovery" %}
{% set docker_image = REVPI_FLASH_DOCKER_IMAGE %}
{% set docker_image_local = REVPI_FLASH_DOCKER_IMAGE_LOCAL %}
{% set timeout_minutes = 30 %}
{% set test_definitions = [
    {
        "repository": TEST_DEFINITIONS_REPOSITORY,
        "from": "git",
        "branch": TEST_DEFINITIONS_BRANCH,
        "path": "automated/deployment/lava_prog_device.yaml",
        "name": "auto-programming-device"
    }
] %}
{% include "include/actions/test.jinja2" %}

{# Boot recovery exit #}
{% set boot_method = "recovery" %}
{% set boot_commands = "exit" %}
{% set namespace = "recovery" %}
{% set timeout_minutes = 5 %}
{% include "include/actions/boot.jinja2" %}
{% endif %}

{# Command: Factory reset #}
{% set command_name = "run_factory_reset" %}
{% set namespace = "recovery" %}
{% set timeout_minutes = 5 %}
{% include "include/actions/command.jinja2" %}

{# Command: Wait for SSH #}
{% set command_name = "wait_for_ssh" %}
{% set namespace = "recovery" %}
{% set timeout_minutes = 5 %}
{% include "include/actions/command.jinja2" %}

{% endblock flash_revpi %}
